# --- PostgreSQL (used by Docker Compose and the API) ---
POSTGRES_DB=dfpmp
POSTGRES_USER=dfpmp
POSTGRES_PASSWORD=
# Use "localhost" when running the API with `make api`; Docker Compose overrides this to "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full connection string takes precedence over the POSTGRES_* values above.
# DATABASE_URL=postgres://dfpmp:password@localhost:5432/dfpmp?sslmode=disable

# --- Published ports (Docker Compose) ---
API_PORT=8080
WEB_PORT=5173

# --- API ---
PORT=8080
WEB_ORIGIN=http://localhost:5173
CONFIG_DIR=config

# --- Authentication ---
# preview: every request acts as PREVIEW_USER_EMAIL (development only, never production).
# entra: Microsoft Entra ID sign-in (requires the ENTRA_* settings below). Any other value disables sign-in.
AUTH_MODE=preview
PREVIEW_USER_EMAIL=hasitha@example.com

# Load sample users, projects, work items and meetings into an empty database.
# Set to false with AUTH_MODE=entra so Outlook invitations never go to sample addresses.
SEED_DEMO_DATA=true

# --- Microsoft Entra ID / Microsoft 365 (see docs/integrations.md) ---
# AUTH_MODE=entra enables Microsoft sign-in. Fill these from the Entra app registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Secret value (not the secret ID). Use a certificate/secret store in production.
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
# Comma-separated sign-in names (UPN/email) that become administrators on first sign-in.
BOOTSTRAP_ADMIN_UPNS=
# Role given to people who sign in or are added from the directory for the first time.
DEFAULT_ROLE=team_member
# 32 random bytes, base64. Encrypts Microsoft tokens at rest. Generated by `make env-init`.
SESSION_ENCRYPTION_KEY=
SESSION_TTL=10h

# --- SharePoint project documents (application permission Sites.Selected) ---
SHAREPOINT_SITE_URL=
# Optional document library name; the site's default library is used when empty.
SHAREPOINT_LIBRARY=
